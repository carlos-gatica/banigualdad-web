           target="_blank" 
           aria-label="Contactar por WhatsApp"
           class="flex items-center gap-2 bg-brandRed hover:bg-red-700 text-white font-bold px-4 py-3 rounded-full shadow-2xl transition-all transform hover:scale-105 active:scale-95 border-2 border-white">
            <i class="fa-brands fa-whatsapp text-2xl"></i>
            <span class="text-sm font-bold pr-1">WhatsApp</span>
        </a>
    </div>

    <script>
        // Toggle Menú Móvil
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Toggle Preguntas Frecuentes (FAQ)
        const faqToggles = document.querySelectorAll('.faq-toggle');

        faqToggles.forEach(toggle => {
            toggle.addEventListener('click', () => {
                const content = toggle.nextElementSibling;
                const icon = toggle.querySelector('i');

                // Alternar visibilidad
                content.classList.toggle('hidden');
                
                // Rotar icono
                if (content.classList.contains('hidden')) {
                    icon.style.transform = 'rotate(0deg)';
                } else {
                    icon.style.transform = 'rotate(180deg)';
                }
            });
        });

        // Generador de Mensaje de WhatsApp personalizable
        const btnSendWa = document.getElementById('send-custom-wa');
        btnSendWa.addEventListener('click', () => {
            const nombre = document.getElementById('msg-nombre').value.trim();
            const sector = document.getElementById('msg-sector').value.trim();
            const texto = document.getElementById('msg-texto').value.trim();

            let mensaje = "Hola Francisco, ";
            if (nombre) mensaje += `mi nombre es ${nombre}. `;
            if (sector) mensaje += `Soy de ${sector}. `;
            if (texto) {
                mensaje += `Consulta: ${texto}`;
            } else {
                mensaje += "Quisiera más información sobre los grupos de emprendedores.";
            }

            const url = `https://wa.me/56993650594?text=${encodeURIComponent(mensaje)}`;
            window.open(url, '_blank');
        });
    </script>
